# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wyxr_texts

# Session
SESSION_SECRET=your-secret-key-change-in-production

# Auth (hardcoded credentials)
AUTH_USERNAME=your-username
AUTH_PASSWORD=your-secure-password

# Twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
LISTENER_PHONE_DISPLAY=901-555-WYXR
# Exact public URL Twilio posts to. Used for webhook signature validation in
# production (NODE_ENV=production). Must be updated whenever the Render/ngrok
# URL changes, or Twilio webhooks will be rejected with 403.
TWILIO_WEBHOOK_URL=https://your-backend-url.onrender.com/webhook/sms

# Server
PORT=3001
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:3000

# Dry runs (always "true" for local runs and tests). With SMS_DRY_RUN=true no
# text reaches Twilio; with SLACK_DRY_RUN=true no call reaches Slack.
SMS_DRY_RUN=true
SLACK_DRY_RUN=true

# Staff login (DJ roster, DJ broadcasts). Must differ from AUTH_USERNAME or
# the server refuses to start. Unset = no staff login possible.
STAFF_USERNAME=your-staff-username
STAFF_PASSWORD=your-staff-password

# DJ line - second Twilio number with its own A2P campaign. Unset = DJ
# sending off (it never falls back to TWILIO_PHONE_NUMBER).
DJ_TWILIO_PHONE_NUMBER=+1234567891
# Exact public URL of the DJ webhook, for signature validation. In
# production every DJ webhook request is rejected while this is unset.
DJ_TWILIO_WEBHOOK_URL=https://your-backend-url.onrender.com/webhook/dj-sms
# Minutes between DJ broadcasts (default 2)
DJ_BROADCAST_MIN_INTERVAL_MINUTES=2

# Slack relay for DJ replies. All three must be set or Slack is off.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_DJ_CHANNEL_ID=C0000000000
# Days a DJ's Slack thread stays open before a new one starts (default 7)
DJ_SLACK_THREAD_DAYS=7
