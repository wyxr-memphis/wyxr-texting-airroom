# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wyxr_texts

# Session
SESSION_SECRET=your-secret-key-change-in-production

# Auth (hardcoded credentials)
AUTH_USERNAME=your-username
AUTH_PASSWORD=your-secure-password

# Twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
LISTENER_PHONE_DISPLAY=901-555-WYXR
# Exact public URL Twilio posts to. Used for webhook signature validation in
# production (NODE_ENV=production). Must be updated whenever the Render/ngrok
# URL changes, or Twilio webhooks will be rejected with 403.
TWILIO_WEBHOOK_URL=https://your-backend-url.onrender.com/webhook/sms

# Server
PORT=3001
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:3000
